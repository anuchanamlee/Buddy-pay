# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของคุณ (ห้าม commit .env.local)

# --- Firebase (ฝั่ง client) ---
# ค่าเหล่านี้ถูกฝังใน JavaScript ของ browser ตามการออกแบบของ Firebase
# ความปลอดภัยของข้อมูลจึงขึ้นกับ firestore.rules ไม่ใช่การซ่อนค่าเหล่านี้
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- ไม่บังคับ / optional ---
# โดเมนที่ใช้สร้างลิงก์แชร์ ถ้าไม่ตั้งจะใช้โดเมนที่เปิดอยู่ (Domain for share links; defaults to the current origin)
NEXT_PUBLIC_APP_URL=

# --- แจ้งเตือนทวงเงินรายวัน (ไม่บังคับ ไม่ตั้ง = ปิดฟีเจอร์นี้) / Daily payment reminders (optional) ---
# สร้างคู่คีย์ในเครื่องตัวเอง: npx web-push generate-vapid-keys
# Generate locally with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
# ค่าด้านล่างเป็นความลับ ตั้งบน Vercel เท่านั้น ห้าม commit / Secrets: set them on Vercel only, never commit
VAPID_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=
CRON_SECRET=

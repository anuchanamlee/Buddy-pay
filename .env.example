# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของคุณ (ห้าม commit .env.local)

# --- Firebase (ฝั่ง client) ---
# ค่าเหล่านี้ถูกฝังใน JavaScript ของ browser ตามการออกแบบของ Firebase
# ความปลอดภัยของข้อมูลจึงขึ้นกับ firestore.rules ไม่ใช่การซ่อนค่าเหล่านี้
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (ฝั่ง server) ---
# ใช้ verify ID token ใน /api/chat ถ้าไม่ระบุจะใช้ NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=

# --- Chatbot (ฝั่ง server เท่านั้น) ---
# ห้ามตั้งชื่อด้วย prefix NEXT_PUBLIC_ เพราะจะทำให้ key ถูกส่งไปที่ browser
# ถ้าเว้นว่าง แชทบอทจะถูกปิด (/api/chat ตอบ 503)
OPENAI_API_KEY=
# ไม่บังคับ ค่าเริ่มต้นคือ gpt-3.5-turbo
OPENAI_MODEL=
